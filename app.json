{
  "expo": {
    "name": "Umma Archive",
    "slug": "umma-archive",
    "scheme": "umma-archive",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/exam-archive-logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/exam-archive-logo.png",
        "backgroundColor": "#f8f9ff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.maryammahamed.ummaarchive"
    },
    "web": {
      "favicon": "./assets/exam-archive-logo.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8f9ff",
          "image": "./assets/exam-archive-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Umma Archive to use photos for profile pictures and booklet cover pages."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Umma Archive to use the camera for photos and QR codes.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Umma Archive to use your location."
        }
      ],
      "expo-document-picker",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "25de6a80-d0cd-4836-8d3b-d7e29293d9e3"
      },
      "supabaseUrl": "https://vrwmhxxhwrbbdrsvrhhc.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZyd21oeHhod3JiYmRyc3ZyaGhjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE0NjQ5ODgsImV4cCI6MjEwNzA0MDk4OH0.954RYtx7SkK07KHceXq8UB_S066yHRq7jVI5F_ZsLI4"
    }
  }
}
